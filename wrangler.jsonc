{
  "name": "noteshub",
  "main": "worker.js",
  "compatibility_date": "2026-11-24",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/sitemap.xml"
    ],
    "html_handling": "drop-trailing-slash"
  }
}
